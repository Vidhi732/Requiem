# TrafficPulse AI Environment Configuration
# TomTom Developer API Key (Traffic Flow & Routing)
TOMTOM_API_KEY=your_tomtom_api_key_here

# Google Gemini API Key (AI Traffic Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# FastAPI Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Optional: Configurable Center Coordinates Override (lat,lon)
# Defaults are pre-configured in backend/config.py
# BENGALURU_COORDS=12.9716,77.5946
# MUMBAI_COORDS=19.0760,72.8777
# PUNE_COORDS=18.5204,73.8567
# DELHI_COORDS=28.6139,77.2090
